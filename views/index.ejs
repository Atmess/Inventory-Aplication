<!DOCTYPE html>
<head> 
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <div id="container">
<header><div class="headerid" onclick="
        document.getElementById('Product').style.display = 'none';
        document.getElementById('categories').style.display = 'block';
  "><h1>categories</h1></div>
        <div class="headerid" onclick="
        document.getElementById('categories').style.display = 'none';
        document.getElementById('Product').style.display = 'block';
        "><h1>Product</h1></div>
      </header>
<div id="main">
<div id="categories" >
  <h1>categories</h1>
  <a href="/newCategories">create New Categories</a>
    <ul>
       <% categories.forEach((category)=> { %>
      <li>
        <strong>Name:</strong> <%= category.name %><br>
        <strong>Desc:</strong> <%= category.description %>
      </li>
       <form action="/deleteCategories/<%= category.id %>" method="POST">
      <button type="submit">Delete</button>
    </form>
  <% }) %>
    </ul>
  </div>


<div id="Product" >
    <h1><%= title %></h1>
    <nav>
      <button><a href="/">All Categories</a></button>
        <% categories.forEach((category)=> { %>
      <button ><a href="/categories/<%= category.id %>"><%= category.name %></a></button>
  <% }) %>
    </nav>
   <ul>
    <a href="/newProduct">create New Product</a>
  <% Product.forEach((Product)=> { %>
    <li>
      <strong>name:</strong> <%= Product.name %> <br>
      <strong>description:</strong> <%= Product.description %> <br>
      <strong>Price:</strong> <%= Product.price %><br>
      <strong>Stock:</strong> <%= Product.stock %> <br>
      <strong>categories:</strong> <%= Product.category_name %>
       
    </li>
    <div style="display: flex; flex-direction: row; gap: 10px;">
    <!-- Add this Delete Form -->
    <form action="/deleteProduct/<%= Product.id %>" method="POST">
      <button type="submit">Delete</button>
    </form>
     <button onclick="
      const panel = document.getElementById('stock-update<%= Product.id %>')
      panel.style.display = panel.style.display === 'none' ? 'inline' : 'none';
     " >Update Stock</button>
  </div>
  <div id="stock-update<%= Product.id %>" style="display: none;">
    <button onclick="
      const sellid = document.getElementById('sell-<%= Product.id%>')
      const reStock = document.getElementById('ReStock-<%= Product.id%>')
      reStock.style.display = 'none';
      sellid.style.display = sellid.style.display === 'none' ? 'inline' : 'none';
      ">sell</button>
      <button onclick="
      const ReStock = document.getElementById('ReStock-<%= Product.id%>')
      const sellid = document.getElementById('sell-<%= Product.id%>')
      sellid.style.display = 'none';
      ReStock.style.display = ReStock.style.display === 'none' ? 'inline' : 'none';      
      ">ReStock</button>
    <form action="/updatestock/<%= Product.id %>" method="POST" id="sell-<%= Product.id %>" style="display: none;" onsubmit="this.change.value = -Math.abs(this.change.value)">
      <label for="sell-change-<%= Product.id %>">Sell</label>
      <input type="number" name="change" id="sell-change-<%= Product.id %>" min="1" required>
      <button type="submit">submit</button>
    </form>
  <form action="/updatestock/<%= Product.id %>" method="POST" id="ReStock-<%= Product.id %>" style="display: none;">
      <label for="restock-change-<%= Product.id %>">ReStock</label>
      <input type="number" name="change" id="restock-change-<%= Product.id %>" min="1" required>
      <button type="submit">submit</button>
    </form></div>
  <% }) %>
</ul>
</div>
</div>
</div>
</body>